#!/usr/bin/env bash
#
# cleanup — runs just before a lane is archived or deleted, from
# .lanes/config/hook/cleanup, with the lane folder as the working directory.
# Use it to tear down whatever the lane opened (terminal tabs, editor windows,
# browser tabs). Best-effort: its output is ignored and a non-zero exit never
# blocks the archive/delete.
#
# Env from Lanes:
#   LANE_DIR, LANE_NAME, LANE_ID   — always
#   TICKET_KEY, TICKET_URL         — when a ticket is linked to the lane
#
# This example just closes the iTerm2 sessions this lane opened. For a fuller
# version that also handles Ghostty, Chrome, Fork and VS Code, enable the
# "Close lane windows" cleanup hook from the default catalog
# (Settings → Catalogs → Hooks).
set -uo pipefail

LANE_ID="${LANE_ID:-}"
[[ -n "$LANE_ID" ]] || exit 0

# Close every iTerm2 session Lanes tagged «lane:<LANE_ID>:…».
osascript <<APPLESCRIPT >/dev/null 2>&1 || true
if application "iTerm2" is running then
  tell application "iTerm2"
    with timeout of 5 seconds
      repeat with w in windows
        repeat with t in tabs of w
          repeat with s in sessions of t
            set tg to ""
            try
              tell s to set tg to (variable named "user.lane")
            end try
            if tg starts with "«lane:${LANE_ID}:" then
              try
                tell s to close
              end try
            end if
          end repeat
        end repeat
      end repeat
    end timeout
  end tell
end if
APPLESCRIPT

exit 0
